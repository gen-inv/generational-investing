name: Regression Tests

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Setup Wrangler
        run: npm install -g wrangler

      - name: Create local database
        run: |
          npm run db:migrate:local

      - name: Build application
        run: npm run build

      - name: Install PM2
        run: npm install -g pm2

      - name: Start server
        run: |
          pm2 start ecosystem.config.cjs
          sleep 5

      - name: Check server health
        run: |
          curl --retry 5 --retry-delay 2 http://localhost:3000
          if [ $? -ne 0 ]; then
            echo "Server failed to start"
            pm2 logs --nostream
            exit 1
          fi

      - name: Run regression tests
        run: npm test

      - name: Generate coverage report
        if: always()
        run: npm run test:coverage

      - name: Upload coverage to Codecov
        if: always()
        uses: codecov/codecov-action@v4
        with:
          files: ./coverage/coverage-final.json
          fail_ci_if_error: false

      - name: Display PM2 logs on failure
        if: failure()
        run: pm2 logs --nostream --lines 100

      - name: Stop server
        if: always()
        run: pm2 delete all || true

      - name: Test Summary
        if: always()
        run: |
          echo "## Test Results" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          if [ -f coverage/coverage-summary.json ]; then
            echo "Coverage: $(jq -r '.total.lines.pct' coverage/coverage-summary.json)%" >> $GITHUB_STEP_SUMMARY
          fi
