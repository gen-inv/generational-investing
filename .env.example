# Copy to .env (local, git-ignored) and fill in NEW keys. Production reads them as Cloudflare Pages secrets:
#   node scripts/push-secrets.mjs      then      npm run deploy
# For `wrangler pages dev`, copy the same lines into .dev.vars.
JWT_SECRET=
MASSIVE_API_KEY=
EODHD_API_KEY=
CRON_SECRET=
RAPIDAPI_KEY=
RESEARCH_INGEST_TOKEN=
# Optional, used by `npm run smoke`:
SMOKE_EMAIL=
SMOKE_PASSWORD=
